    {
      "id": "lrn001_petdex_format",
      "label": "LRN-001: Petdex Standardized Format 8×9 Grid 192×208px 9 States",
      "file_type": "rationale",
      "source_file": ".claude/memory/learnings/LRN-001.md",
      "source_location": "LRN-001",
      "source_url": null,
      "captured_at": "2026-05-04",
      "author": null,
      "contributor": null,
      "rationale": "Petdex grid is fixed 8 columns × 9 rows, 1536×1872px total, 192×208px per cell. Each row is a named animation state with a defined frame count. This fixed format enables auto-detection in the Core without a manual SpriteManifest."
    },
    {
      "id": "lrn002_state_mapping",
      "label": "LRN-002: Petdex→Clawd State Mapping (6 of 9 states mapped)",
      "file_type": "rationale",
      "source_file": ".claude/memory/learnings/LRN-002.md",
      "source_location": "LRN-002",
      "source_url": null,
      "captured_at": "2026-05-04",
      "author": null,
      "contributor": null,
      "rationale": "6 Petdex states map to Clawd on Desk states; run-right (row 1) and run-left (row 2) are silently ignored by the Clawd adapter. Mapping: idle→idle, thinking→waiting, working→running, error→failed, happy→waving, notification→review, sleeping→idle, waking→jumping."
    },
    {
      "id": "lrn003_provisional_mapping",
      "label": "LRN-003: Petdex→Clawd Mapping is Provisional and Adjustable",
      "file_type": "rationale",
      "source_file": ".claude/memory/learnings/LRN-003.md",
      "source_location": "LRN-003",
      "source_url": null,
      "captured_at": "2026-05-04",
      "author": null,
      "contributor": null,
      "rationale": "The mapping table is a first approximation intended to be adjusted after real-pet terrain tests. Code should keep mapping in a config table, not dispersed hardcoded values."
    },
    {
      "id": "lrn004_bmad_shortcircuit",
      "label": "LRN-004: bmad-product-brief Short-Circuitable When RFC + Memory Present",
      "file_type": "rationale",
      "source_file": ".claude/memory/learnings/LRN-004.md",
      "source_location": "LRN-004",
      "source_url": null,
      "captured_at": "2026-05-04",
      "author": null,
      "contributor": null,
      "rationale": "When a project has a complete RFC and structured agent memory, stages 1-2 of the product-brief workflow (intent + contextual discovery) can be skipped to go directly to draft."
    },
    {
      "id": "lrn005_python_fallback",
      "label": "LRN-005: resolve_customization.py Unusable on Windows Without Python - Manual Fallback Sufficient",
      "file_type": "rationale",
      "source_file": ".claude/memory/learnings/LRN-005.md",
      "source_location": "LRN-005",
      "source_url": null,
      "captured_at": "2026-05-04",
      "author": null,
      "contributor": null,
      "rationale": "BMAD script resolve_customization.py fails silently on Windows when Python is absent from PATH. Reading customize.toml directly is an equivalent fallback when no override files exist."
    },
    {
      "id": "lrn006_bmad_scope_duplication",
      "label": "LRN-006: BMAD PRD Multi-step Scope Duplication to Merge in Step-11",
      "file_type": "rationale",
      "source_file": ".claude/memory/learnings/LRN-006.md",
      "source_location": "LRN-006",
      "source_url": null,
      "captured_at": "2026-05-04",
      "author": null,
      "contributor": null,
      "rationale": "Steps 3 and 8 of bmad-create-prd produce overlapping Scope content. Step-11 polish must systematically audit and merge these into a single unified section (Product Scope & Roadmap)."
    },
    {
      "id": "lrn007_bmad_category_filter",
      "label": "LRN-007: BMAD Step-04 Category Filtering for CLI Tools",
      "file_type": "rationale",
      "source_file": ".claude/memory/learnings/LRN-007.md",
      "source_location": "LRN-007",
      "source_url": null,
      "captured_at": "2026-05-04",
      "author": null,
      "contributor": null,
      "rationale": "For a pure CLI tool, the 5 generic BMAD step-04 decision categories (Data, Auth, API, Frontend, Infrastructure) should be replaced by 3 project-specific ones: (1) pipeline internal architecture, (2) public interface contract, (3) infra & distribution."
    },
    {
      "id": "lrn008_language_check",
      "label": "LRN-008: Check document_output_language Before bmad-epics-and-stories Step-03",
      "file_type": "rationale",
      "source_file": ".claude/memory/learnings/LRN-008.md",
      "source_location": "LRN-008",
      "source_url": null,
      "captured_at": "2026-05-04",
      "author": null,
      "contributor": null,
      "rationale": "BMAD generates stories in English by default if document_output_language is not controlled before step-03. Must verify config.yaml setting and apply the native language from the first story."
    },
    {
      "id": "lrn009_core_epic_derogation",
      "label": "LRN-009: CLI Tool Core Epic Without End-User Value is Acceptable Derogation",
      "file_type": "rationale",
      "source_file": ".claude/memory/learnings/LRN-009.md",
      "source_location": "LRN-009",
      "source_url": null,
      "captured_at": "2026-05-04",
      "author": null,
      "contributor": null,
      "rationale": "For a CLI tool with Core/CLI separation, the Core epic does not deliver standalone end-user value. BMAD flags this as a violation but it is an expected and acceptable derogation for this architecture pattern."
    },
    {
      "id": "lrn010_coverage_map_ux",
      "label": "LRN-010: Coverage Map ≠ UX AC Coverage - Verify WHEN/HOW Not Just WHAT",
      "file_type": "rationale",
      "source_file": ".claude/memory/learnings/LRN-010.md",
      "source_location": "LRN-010",
      "source_url": null,
      "captured_at": "2026-05-04",
      "author": null,
      "contributor": null,
      "rationale": "A FR marked covered in the Coverage Map may have assigned stories with ACs too vague to describe the concrete UX flow. Must verify: (1) trigger condition, (2) interaction flow, (3) validation/error handling for each user-interaction FR."
    },
